generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  COOK
  RIDER
  ADMIN
}

enum RoleStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OrderStatus {
  AWAITING_PAYMENT
  SUBMITTED
  COOK_ACCEPTED
  CONFIRMED
  PREPARING
  READY
  RIDER_ASSIGNED
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum BatchStatus {
  OPEN
  FULL
  CONFIRMED
  COOKING
  READY
  DONE
  FAILED
}

enum RequestStatus {
  OPEN
  PROPOSALS
  ACCEPTED
  CANCELLED
  EXPIRED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PaymentMethod {
  BKASH
  SSLCOMMERZ
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  PAID
  FAILED
}

enum ComplaintStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

model User {
  id            String         @id @default(cuid())
  phone         String?        @unique // signed up with mobile, or added later for delivery
  email         String?        @unique // signed up with Gmail / email
  name          String?
  area          String?
  language      String         @default("en")
  loyaltyPoints Int            @default(0)
  referralCode  String?        @unique
  suspended     Boolean        @default(false)
  /// When the person agreed to the Terms of Service and Privacy Policy (asked once at sign-up, again if they change).
  termsAcceptedAt DateTime?
  /// Food preferences used to suggest dishes and warn about allergens.
  dietPrefs     String[]       @default([])
  allergies     String[]       @default([])
  /// Set when the number was confirmed with an SMS code (null if it was saved while SMS wasn't set up yet).
  phoneVerifiedAt DateTime?
  /// Who invited them (referral code entered at sign-up).
  referredById  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  roles         UserRole[]
  cook          CookProfile?
  rider         RiderProfile?
  addresses     Address[]
  orders        Order[]        @relation("CustomerOrders")
  deliveries    Order[]        @relation("RiderOrders")
  requests      FoodRequest[]
  reviews       Review[]
  favorites     Favorite[]
  notifications Notification[]
  pushTokens    PushToken[]
  complaints    Complaint[]
  refreshTokens RefreshToken[]
  documents     Document[]
  subscriptions Subscription[]
  agreements    PartnerAgreement[]
  riderLedger   RiderLedger[]
  tickets       SupportTicket[]
  deletedAt     DateTime?
}

model UserRole {
  id        String     @id @default(cuid())
  userId    String
  role      Role
  status    RoleStatus @default(PENDING)
  note      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model OtpCode {
  id         String    @id @default(cuid())
  /// Where the code was sent: a phone number (01XXXXXXXXX) or an email address.
  target     String    @map("phone")
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([target, createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String
  area      String
  road      String
  house     String
  floor     String?
  landmark  String?
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CookProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  displayName     String
  intro           String      @default("")
  specialties     String[]
  area            String
  hours           String      @default("11:00-20:00")
  dailyCapacity   Int         @default(20)
  accepting       Boolean     @default(false)
  experience      String?
  kitchenInfo     String?
  hygieneChecks   Int         @default(0)
  nidLast4        String?
  payoutWallet    String?
  /// The mother's own words, shown on her page ("30 years of cooking for my family…").
  story           String      @default("")
  /// Home district whose food she's known for, e.g. sylhet, chattogram (see REGIONS).
  region          String?
  portraitId      String?     // MediaImage: her photo
  kitchenPhotoId  String?     // MediaImage: her kitchen
  /// Last in-person kitchen inspection by the MaaCrave team.
  inspectedAt     DateTime?
  /// Paused by the team (complaints, failed inspection). Can't take orders until then.
  pausedUntil     DateTime?
  pauseReason     String?
  /// The cook's own leave ("on holiday until"). She can't take orders until then.
  awayUntil       DateTime?
  /// BFSA food business registration / licence number, if she has one.
  foodLicence     String?
  lat             Float?      // kitchen location for the delivery map
  lng             Float?
  rating          Float       @default(0)
  ratingCount     Int         @default(0)
  completedOrders Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dishes          Dish[]
  proposals       Proposal[]
  batches         Batch[]
  orders          Order[]
  payouts         Payout[]
  favorites       Favorite[]
  reviews         Review[]
  plans           MealPlan[]

  @@index([area])
}

model RiderProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  vehicle   String
  online    Boolean  @default(false)
  nidLast4  String?
  /// Last known position while online, for nearest-rider offers and live tracking.
  lat       Float?
  lng       Float?
  locatedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Dish {
  id            String      @id @default(cuid())
  cookId        String
  name          String
  nameBn        String?
  category      String
  price         Int
  portion       String
  prepMinutes   Int
  ingredients   String[]
  allergens     String[]
  description   String      @default("")
  spice         Int         @default(1)
  dailyCapacity Int         @default(20)
  available     Boolean     @default(true)
  photoUrl      String?
  photoId       String?     // MediaImage uploaded by the cook
  region        String?     // district style, e.g. chattogram mezbani
  healthTags    String[]    @default([]) // diabetic, low-oil, low-salt, kids, patient, veg
  festivalId    String?     // part of a festival pre-order menu
  rating        Float       @default(0)
  ratingCount   Int         @default(0)
  orderCount    Int         @default(0)
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  cook          CookProfile @relation(fields: [cookId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  batches       Batch[]
  favorites     Favorite[]
  reviews       Review[]

  @@index([category])
  @@index([cookId])
}

model FoodRequest {
  id               String        @id @default(cuid())
  customerId       String
  dishName         String
  category         String
  portions         Int
  budgetPerPortion Int
  neededAt         DateTime
  area             String
  addressId        String?
  spice            String        @default("Medium")
  oil              String        @default("Normal")
  diet             String[]
  exclusions       String?
  allergies        String?
  notes            String?
  allowGroup       Boolean       @default(true)
  status           RequestStatus @default(OPEN)
  createdAt        DateTime      @default(now())
  customer         User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  proposals        Proposal[]
  order            Order?
  declinedBy       String[]

  @@index([status, area])
}

model Proposal {
  id              String         @id @default(cuid())
  requestId       String
  cookId          String
  pricePerPortion Int
  note            String?
  status          ProposalStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  request         FoodRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  cook            CookProfile    @relation(fields: [cookId], references: [id], onDelete: Cascade)

  @@unique([requestId, cookId])
}

model Batch {
  id              String      @id @default(cuid())
  cookId          String
  dishId          String?
  title           String
  pricePerPortion Int
  minPortions     Int
  maxPortions     Int
  cutoffAt        DateTime
  readyBy         DateTime
  area            String
  status          BatchStatus @default(OPEN)
  createdAt       DateTime    @default(now())
  cook            CookProfile @relation(fields: [cookId], references: [id], onDelete: Cascade)
  dish            Dish?       @relation(fields: [dishId], references: [id])
  orders          Order[]

  @@index([status, cutoffAt])
}

model Order {
  id             String       @id @default(cuid())
  code           String       @unique
  customerId     String
  cookId         String
  batchId        String?
  requestId      String?      @unique
  riderId        String?
  status         OrderStatus
  subtotal       Int
  serviceFee     Int
  deliveryFee    Int
  discount       Int          @default(0)
  total          Int
  commission     Int
  cookEarning    Int
  riderPayout    Int
  tip            Int          @default(0) // added by the customer at checkout; 100% goes to the rider
  /// The customer's allergies at the time of ordering, shown to the cook in red.
  allergyNote    String?
  /// When nearby riders were re-alerted because nobody took the pickup.
  riderNudgedAt  DateTime?
  couponCode     String?
  addressText    String
  lat            Float?      // delivery point copied from the address at checkout
  lng            Float?
  area           String
  deliveryOtp    String
  notes          String?
  scheduledFor   DateTime?
  idempotencyKey String?      @unique
  subscriptionId String?      // set when the order was created from a meal plan
  distanceKm     Float?       // estimated road distance kitchen → customer, used for delivery fee and rider pay
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  customer       User         @relation("CustomerOrders", fields: [customerId], references: [id])
  cook           CookProfile  @relation(fields: [cookId], references: [id])
  batch          Batch?       @relation(fields: [batchId], references: [id])
  request        FoodRequest? @relation(fields: [requestId], references: [id])
  rider          User?        @relation("RiderOrders", fields: [riderId], references: [id])
  items          OrderItem[]
  events         OrderEvent[]
  payment        Payment?
  review         Review?
  complaints     Complaint[]

  @@index([customerId, createdAt])
  @@index([cookId, status])
  @@index([status, riderId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  dishId    String?
  name      String
  unitPrice Int
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish      Dish?   @relation(fields: [dishId], references: [id])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  actorId   String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String        @unique
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amount      Int
  providerRef String?
  providerTrx String?
  returnTo    String?       // 'app' or 'web' — where the gateway sends the customer back
  raw         Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String
  value       Int
  minOrder    Int       @default(0)
  maxDiscount Int
  batchOnly   Boolean   @default(false)
  active      Boolean   @default(true)
  usageLimit  Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  description String    @default("")
}

model Review {
  id        String       @id @default(cuid())
  orderId   String       @unique
  userId    String
  cookId    String
  dishId    String?
  stars     Int
  /// Optional detail ratings, 1–5.
  portion   Int?
  packaging Int?
  hygiene   Int?
  text      String?
  createdAt DateTime     @default(now())
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cook      CookProfile  @relation(fields: [cookId], references: [id], onDelete: Cascade)
  dish      Dish?        @relation(fields: [dishId], references: [id])
}

model Favorite {
  id        String       @id @default(cuid())
  userId    String
  dishId    String?
  cookId    String?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dish      Dish?        @relation(fields: [dishId], references: [id], onDelete: Cascade)
  cook      CookProfile? @relation(fields: [cookId], references: [id], onDelete: Cascade)

  @@unique([userId, dishId])
  @@unique([userId, cookId])
}

model Complaint {
  id              String          @id @default(cuid())
  orderId         String
  userId          String
  type            String
  text            String
  refundRequested Boolean         @default(false)
  refundAmount    Int             @default(0)
  status          ComplaintStatus @default(OPEN)
  resolution      String?         // what the team did, shown to the customer
  refundedAmount  Int             @default(0)
  /// Who bears the refund: COOK (deducted from their earnings), RIDER, or MAACRAVE.
  chargedTo       String?
  createdAt       DateTime        @default(now())
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  role      Role
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, role, createdAt])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payout {
  id          String       @id @default(cuid())
  cookId      String
  amount      Int
  status      PayoutStatus @default(REQUESTED)
  method      String
  providerRef String?
  createdAt   DateTime     @default(now())
  cook        CookProfile  @relation(fields: [cookId], references: [id], onDelete: Cascade)
}

model PlatformSetting {
  id               Int   @id @default(1)
  commissionPct    Float @default(10)
  serviceFee       Int   @default(12)
  deliveryFee      Int   @default(45)
  batchDeliveryFee Int   @default(25)
  riderPayout      Int   @default(35)
  defaultMinBatch  Int   @default(8)
  requestRadiusKm  Int   @default(8)
  /// Delivery pricing by distance: customer pays deliveryFee for the first freeKm, then deliveryPerKm for each extra km.
  freeKm           Float @default(3)
  deliveryPerKm    Int   @default(10)
  /// Rider pay: base + perKm × road km. A group-order drop uses riderBatchDrop as its base.
  riderBase        Int   @default(25)
  riderPerKm       Int   @default(6)
  riderBatchDrop   Int   @default(20)
  /// Riders can't take new cash orders while holding more than this much customer cash.
  riderCashLimit   Int   @default(3000)
  /// Goes up whenever partner rates change; cooks and riders accept the new version in the app.
  ratesVersion     Int   @default(1)
  ratesUpdatedAt   DateTime?
  /// One-time data upgrades already applied to this row.
  upgrades         Int   @default(0)
  /// "Mother of the week" shown on Home, chosen in the admin panel.
  featuredCookId   String?
}

/// Messages about one order between the customer, the cook and the rider. Phone numbers stay private.
model OrderMessage {
  id        String   @id @default(cuid())
  orderId   String
  senderId  String
  role      String   // CUSTOMER | COOK | RIDER
  body      String
  createdAt DateTime @default(now())
  @@index([orderId, createdAt])
}

/// Photos uploaded by cooks (dishes, portrait, kitchen). Served from /v1/media/:id. The team can remove any.
model MediaImage {
  id        String   @id @default(cuid())
  ownerId   String   // user id
  kind      String   // DISH | PORTRAIT | KITCHEN
  mime      String
  data      String   // base64
  removed   Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([kind, createdAt])
}

/// A festival pre-order window (Eid, Pohela Boishakh, Pitha utsob, Ramadan iftar…).
model Festival {
  id        String   @id @default(cuid())
  title     String
  titleBn   String
  blurb     String   @default("")
  blurbBn   String   @default("")
  opensAt   DateTime // customers can start pre-ordering
  closesAt  DateTime // last moment to order
  deliverOn DateTime // the day the food arrives
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// A cook or rider agreeing to the partner terms and the rates of a given version.
model PartnerAgreement {
  id            String   @id @default(cuid())
  userId        String
  role          Role
  version       Int
  commissionPct Float
  rates         Json
  acceptedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, role, version])
}

/// Money moving between a rider and MaaCrave: cash the rider handed in, or earnings paid to the rider.
model RiderLedger {
  id         String   @id @default(cuid())
  riderId    String   // user id
  kind       String   // CASH_DEPOSIT | PAYOUT
  amount     Int
  reference  String?
  adminEmail String
  createdAt  DateTime @default(now())
  rider      User     @relation(fields: [riderId], references: [id], onDelete: Cascade)
  @@index([riderId, createdAt])
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

/// Help requests from customers, cooks and riders, answered from the admin panel.
model SupportTicket {
  id        String           @id @default(cuid())
  userId    String
  role      Role
  orderId   String?
  subject   String
  status    TicketStatus     @default(OPEN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  SupportMessage[]
  @@index([status, updatedAt])
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  fromAdmin  Boolean       @default(false)
  adminEmail String?
  body       String
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

/// Verification documents uploaded with a cook or rider application (NID, kitchen photos, licence).
/// Stored as compressed base64 images; only the admin panel can read them.
model Document {
  id        String   @id @default(cuid())
  userId    String
  role      Role
  kind      String   // NID_FRONT, NID_BACK, KITCHEN, LICENSE
  mime      String
  data      String   // base64, no data: prefix
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, role])
}

/// Every action taken in the admin panel, for accountability.
model AdminLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String
  targetId   String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// The four animated cards under "What are you craving?" on the Home screen. Edited from the admin panel.
model Spotlight {
  slot       Int      @id // 1–4
  title      String
  titleBn    String
  subtitle   String
  subtitleBn String
  icon       String   // soup, fish, drumstick, beef, leaf, cake, cookie, sun, moon, flame, sparkles, users, gift, heart, utensils, request, percent, coffee
  theme      String   // crimson, saffron, forest, night, rose, ocean
  animation  String   // float, steam, pulse, shine, wiggle, spin
  action     String   // browse | request | groups | plans | category:<key> | maxPrice:<n>
  layout     String   @default("arch") // arch: title on a curved band over the picture · poster: picture fills the card
  imageMime  String?
  imageData  String?  // optional illustration uploaded from the admin panel (base64)
  active     Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
}

enum PlanPeriod {
  WEEKLY
  MONTHLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  ENDED
}

/// A meal plan a cook offers: e.g. "Weekday lunch box", lunch, monthly, 6 days a week, ৳140 per meal.
model MealPlan {
  id          String         @id @default(cuid())
  cookId      String
  title       String
  description String         @default("")
  meal        MealSlot
  period      PlanPeriod
  days        Int[]          // weekdays it is delivered, 0 = Sunday … 6 = Saturday
  pricePerMeal Int
  deliverAt   String         // "08:00", "13:00", "20:30"
  capacity    Int            @default(20)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  cook        CookProfile    @relation(fields: [cookId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([meal, period, active])
}

/// A customer's subscription. Each delivery day the server creates a normal order (cash on delivery).
model Subscription {
  id          String             @id @default(cuid())
  planId      String
  customerId  String
  status      SubscriptionStatus @default(ACTIVE)
  startDate   DateTime
  endDate     DateTime
  addressText String
  area        String
  lat         Float?
  lng         Float?
  notes       String?
  /// Days the customer skipped (YYYY-MM-DD, Dhaka). No meal is made on these days.
  skipDates   String[]           @default([])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  plan        MealPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  customer    User               @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([status, startDate, endDate])
}
