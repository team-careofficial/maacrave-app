# --- Core ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://maacrave:change-me@localhost:5432/maacrave?schema=public
# Long random strings (openssl rand -hex 32)
JWT_SECRET=
OTP_SECRET=
# Comma-separated origins allowed to call the API from a browser (the Expo web build)
CORS_ORIGINS=http://localhost:8081
# Public URL of this API (used for payment callbacks)
API_PUBLIC_URL=http://localhost:4000
# Where the payment gateway sends the customer back (deep link for the app, or https URL for web)
APP_RETURN_URL=maacrave://payment-result
# Where web (browser) customers land after paying
WEB_RETURN_URL=https://maacrave.app/payment-result

# --- Admin panel (separate website in /admin) ---
# Only these emails can sign in to the admin panel (code sent by email). Comma separated.
ADMIN_EMAILS=
# Separate long random secret for admin sessions (openssl rand -hex 32)
ADMIN_JWT_SECRET=

# --- Continue with Google ---
# OAuth client IDs from Google Cloud Console (web, android, ios), comma separated
GOOGLE_CLIENT_IDS=

# --- SMS (OTP) ---
# SMS_PROVIDER=bulksmsbd | log   (log only works when NODE_ENV=development)
SMS_PROVIDER=log
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# --- Email (sign-in codes for Gmail / email users) ---
# EMAIL_PROVIDER=smtp | brevo | log   (log only works when NODE_ENV=development)
EMAIL_PROVIDER=log
EMAIL_FROM=
# Gmail SMTP: SMTP_USER = your Gmail address, SMTP_PASS = a 16-letter Google "App password" (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Brevo (works on hosts that block SMTP, e.g. Render free plan)
BREVO_API_KEY=

# --- bKash Tokenized Checkout ---
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# --- SSLCommerz (cards, Nagad, Rocket) ---
SSLCZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=

# --- Expo push ---
EXPO_ACCESS_TOKEN=
