{
  "expo": {
    "name": "MaaCrave",
    "slug": "maacrave",
    "scheme": "maacrave",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": { "image": "./assets/splash-mark.png", "resizeMode": "contain", "backgroundColor": "#C2441F" },
    "ios": {
      "bundleIdentifier": "app.maacrave.mobile",
      "supportsTablet": true,
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "app.maacrave.mobile",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#C2441F" },
      "permissions": ["POST_NOTIFICATIONS", "ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "CAMERA", "REQUEST_INSTALL_PACKAGES"]
    },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/favicon.png", "name": "MaaCrave", "themeColor": "#FFFFFF" },
    "plugins": [
      "expo-router",
      ["expo-location", { "locationWhenInUsePermission": "MaaCrave uses your location to pin your delivery address and, for riders, to show customers where their food is." }],
      "expo-secure-store",
      "expo-font",
      ["expo-notifications", { "color": "#7A1F24" }],
      ["expo-splash-screen", { "image": "./assets/splash-mark.png", "imageWidth": 120, "backgroundColor": "#C2441F" }],
      ["expo-image-picker", { "photosPermission": "MaaCrave needs your photos to upload your NID and kitchen pictures for verification.", "cameraPermission": "MaaCrave uses the camera to photograph your NID and kitchen for verification." }]
    ],
    "experiments": { "typedRoutes": false },
    "extra": { "eas": { "projectId": "REPLACE_WITH_EAS_PROJECT_ID" } }
  }
}
